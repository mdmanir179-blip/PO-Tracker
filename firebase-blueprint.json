{
  "entities": {
    "EmployeeProfile": {
      "title": "EmployeeProfile",
      "description": "Public directory profile for employees containing work identity, department role, and access permissions.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "User ID of the employee"
        },
        "employeeName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100,
          "description": "Full name of the employee"
        },
        "employeeId": {
          "type": "string",
          "minLength": 2,
          "maxLength": 50,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Mandatory company Employee ID"
        },
        "email": {
          "type": "string",
          "maxLength": 120,
          "description": "Employee work email"
        },
        "role": {
          "type": "string",
          "enum": ["admin", "backoffice", "warehouse", "logistics", "print"],
          "maxLength": 20,
          "description": "Department role of the employee"
        },
        "accessStatus": {
          "type": "string",
          "enum": ["APPROVED", "RESTRICTED"],
          "maxLength": 20,
          "description": "Admin-controlled access permission state"
        },
        "spreadsheetId": {
          "type": "string",
          "maxLength": 128,
          "description": "Optional reference ID"
        },
        "orgScope": {
          "type": "string",
          "enum": ["instamart_ops"],
          "maxLength": 30,
          "description": "Organizational partition scope"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of profile creation"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last profile update"
        }
      },
      "required": ["uid", "employeeName", "employeeId", "role", "spreadsheetId", "createdAt", "updatedAt"]
    },
    "ProductCatalogItem": {
      "title": "ProductCatalogItem",
      "description": "Master product catalog mapping Item ID / SKU to Item Name for instant auto-fill.",
      "type": "object",
      "properties": {
        "itemId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "description": "Product SKU / Item ID"
        },
        "itemName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "Product Name auto-populated when Item ID is entered"
        },
        "orgScope": {
          "type": "string",
          "enum": ["instamart_ops"],
          "maxLength": 30,
          "description": "Organizational partition scope"
        },
        "updatedByName": {
          "type": "string",
          "maxLength": 100,
          "description": "Employee who added/updated the SKU"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp"
        }
      },
      "required": ["itemId", "itemName", "orgScope", "updatedByName", "updatedAt"]
    },
    "PurchaseOrder": {
      "title": "PurchaseOrder",
      "description": "Instamart Purchase Order tracking record across PO Entry, Logistics, Print Verification, In Transit, and GRN stages.",
      "type": "object",
      "properties": {
        "poNumber": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "description": "Purchase Order Number"
        },
        "orderDate": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30,
          "description": "Order Date"
        },
        "poExpiryDate": {
          "type": "string",
          "maxLength": 30,
          "description": "PO Expiry Date"
        },
        "warehouseName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Destination Instamart Warehouse Name"
        },
        "itemId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "description": "Item SKU / ID"
        },
        "itemName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "Item Name"
        },
        "totalQty": {
          "type": "number",
          "description": "Total Quantity ordered"
        },
        "invoiceNo": {
          "type": "string",
          "maxLength": 80,
          "description": "Invoice Number"
        },
        "shipDate": {
          "type": "string",
          "maxLength": 30,
          "description": "Shipment Date"
        },
        "appointmentId": {
          "type": "string",
          "maxLength": 80,
          "description": "Warehouse Appointment ID"
        },
        "appointmentDate": {
          "type": "string",
          "maxLength": 30,
          "description": "Appointment Date"
        },
        "so": {
          "type": "string",
          "maxLength": 80,
          "description": "Sales Order (SO) reference"
        },
        "status": {
          "type": "string",
          "maxLength": 60,
          "description": "Current operational status"
        },
        "noOfBoxes": {
          "type": "number",
          "description": "Total number of boxes"
        },
        "boxDimensions": {
          "type": "string",
          "maxLength": 100,
          "description": "Box dimensions (L x W x H)"
        },
        "logisticsPortal": {
          "type": "string",
          "maxLength": 100,
          "description": "Logistics Partner / Portal name"
        },
        "pickupTrackingId": {
          "type": "string",
          "maxLength": 100,
          "description": "PO Pickup Tracking ID"
        },
        "puc": {
          "type": "string",
          "maxLength": 80,
          "description": "PUC Code / Number"
        },
        "asn": {
          "type": "string",
          "maxLength": 80,
          "description": "Advance Shipping Notice (ASN)"
        },
        "clearBagNo": {
          "type": "string",
          "maxLength": 80,
          "description": "Clear Bag Number"
        },
        "comment": {
          "type": "string",
          "maxLength": 500,
          "description": "Additional comments or remarks"
        },
        "pickupStatus": {
          "type": "string",
          "enum": ["YES", "NO"],
          "maxLength": 10,
          "description": "Pickup Status: YES shifts record to In Transit"
        },
        "printVerified": {
          "type": "string",
          "enum": ["YES", "NO"],
          "maxLength": 10,
          "description": "Print Team Document Verification status (YES / NO)"
        },
        "printVerifiedBy": {
          "type": "string",
          "maxLength": 120,
          "description": "Print Team member who verified the documents"
        },
        "workflowStage": {
          "type": "string",
          "enum": ["PO_ENTRY", "IN_TRANSIT", "GRN"],
          "maxLength": 20,
          "description": "Current stage in the workflow pipeline"
        },
        "inwardStatus": {
          "type": "string",
          "enum": ["PENDING", "SUCCESS"],
          "maxLength": 20,
          "description": "Inward status; SUCCESS shifts record to GRN"
        },
        "grnNumber": {
          "type": "string",
          "maxLength": 80,
          "description": "GRN Number assigned upon inwarding"
        },
        "grnDnSummary": {
          "type": "string",
          "maxLength": 500,
          "description": "Discrepancy Note summary recorded in GRN stage"
        },
        "hasDn": {
          "type": "boolean",
          "description": "Whether this GRN has any Discrepancy Note (DN)"
        },
        "isRto": {
          "type": "boolean",
          "description": "Whether this PO has been marked for RTO (Return to Origin)"
        },
        "rtoPickedStatus": {
          "type": "string",
          "enum": ["YES", "NO", "PENDING"],
          "maxLength": 20,
          "description": "Whether RTO shipment has been picked up (YES / NO / PENDING)"
        },
        "rtoTrackingId": {
          "type": "string",
          "maxLength": 100,
          "description": "RTO return tracking ID / AWB / LR number"
        },
        "rtoCourierPartner": {
          "type": "string",
          "maxLength": 100,
          "description": "Logistics / Courier partner handling RTO return"
        },
        "rtoPickDate": {
          "type": "string",
          "maxLength": 30,
          "description": "Date when RTO shipment was picked up"
        },
        "rtoReceivedAtWh": {
          "type": "string",
          "enum": ["YES", "NO"],
          "maxLength": 10,
          "description": "Whether RTO shipment has been received back at origin warehouse"
        },
        "rtoReason": {
          "type": "string",
          "maxLength": 200,
          "description": "Reason for RTO (e.g. Appointment Rejected, Hub Full, PO Expired, Damaged)"
        },
        "rtoRemarks": {
          "type": "string",
          "maxLength": 500,
          "description": "Additional RTO remarks, vehicle number, or resolution notes"
        },
        "orgScope": {
          "type": "string",
          "enum": ["instamart_ops"],
          "maxLength": 30,
          "description": "Organizational partition scope for secure list queries"
        },
        "createdByUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID of the employee who created the PO"
        },
        "createdByName": {
          "type": "string",
          "maxLength": 100,
          "description": "Name of the employee who created the PO"
        },
        "createdByEmpId": {
          "type": "string",
          "maxLength": 50,
          "description": "Employee ID of the creator"
        },
        "updatedByUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID of the employee who last updated the PO"
        },
        "updatedByName": {
          "type": "string",
          "maxLength": 100,
          "description": "Name of the employee who last updated the PO"
        },
        "updatedByEmpId": {
          "type": "string",
          "maxLength": 50,
          "description": "Employee ID of the last updater"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp"
        }
      },
      "required": [
        "poNumber",
        "orderDate",
        "warehouseName",
        "itemId",
        "itemName",
        "totalQty",
        "invoiceNo",
        "shipDate",
        "appointmentId",
        "appointmentDate",
        "so",
        "status",
        "noOfBoxes",
        "boxDimensions",
        "logisticsPortal",
        "pickupTrackingId",
        "puc",
        "asn",
        "clearBagNo",
        "comment",
        "pickupStatus",
        "workflowStage",
        "inwardStatus",
        "grnNumber",
        "grnDnSummary",
        "hasDn",
        "orgScope",
        "createdByUid",
        "createdByName",
        "createdByEmpId",
        "updatedByUid",
        "updatedByName",
        "updatedByEmpId",
        "createdAt",
        "updatedAt"
      ]
    },
    "DnRecord": {
      "title": "DnRecord",
      "description": "Instamart Discrepancy Note (DN) Tracker entry with uploaded file metadata and LR number.",
      "type": "object",
      "properties": {
        "dnDate": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30,
          "description": "DN Date"
        },
        "dnNumber": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Discrepancy Note Number"
        },
        "facilityName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Instamart Facility / Warehouse Name"
        },
        "parentPoDetails": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "Parent PO Number & Details"
        },
        "dnSkuIdItemName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 250,
          "description": "DN SKU ID | Item Name"
        },
        "dnQty": {
          "type": "number",
          "description": "Discrepancy Note Quantity"
        },
        "whPocDetails": {
          "type": "string",
          "maxLength": 200,
          "description": "Warehouse POC Name / Contact Details"
        },
        "lrNo": {
          "type": "string",
          "maxLength": 80,
          "description": "LR Number"
        },
        "reportFileName": {
          "type": "string",
          "maxLength": 200,
          "description": "Uploaded DN report file name (PDF or spreadsheet)"
        },
        "reportFileType": {
          "type": "string",
          "maxLength": 100,
          "description": "MIME type of the uploaded report file"
        },
        "reportFileSize": {
          "type": "number",
          "description": "File size in bytes (max 10 MB)"
        },
        "reportFileDataUrl": {
          "type": "string",
          "maxLength": 750000,
          "description": "Encoded preview/download payload or reference link for the report file"
        },
        "orgScope": {
          "type": "string",
          "enum": ["instamart_ops"],
          "maxLength": 30,
          "description": "Organizational partition scope for secure list queries"
        },
        "createdByUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID of employee who created the DN entry"
        },
        "createdByName": {
          "type": "string",
          "maxLength": 100,
          "description": "Name of employee who created the DN entry"
        },
        "createdByEmpId": {
          "type": "string",
          "maxLength": 50,
          "description": "Employee ID of creator"
        },
        "updatedByUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID of employee who last updated the DN entry"
        },
        "updatedByName": {
          "type": "string",
          "maxLength": 100,
          "description": "Name of employee who last updated the DN entry"
        },
        "updatedByEmpId": {
          "type": "string",
          "maxLength": 50,
          "description": "Employee ID of last updater"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp"
        }
      },
      "required": [
        "dnDate",
        "dnNumber",
        "facilityName",
        "parentPoDetails",
        "dnSkuIdItemName",
        "dnQty",
        "whPocDetails",
        "lrNo",
        "reportFileName",
        "reportFileType",
        "reportFileSize",
        "reportFileDataUrl",
        "orgScope",
        "createdByUid",
        "createdByName",
        "createdByEmpId",
        "updatedByUid",
        "updatedByName",
        "updatedByEmpId",
        "createdAt",
        "updatedAt"
      ]
    },
    "ActivityLog": {
      "title": "ActivityLog",
      "description": "Audit log of every PO, Logistics, Print, or DN action showing Employee Name, Employee ID, and Department Role for Admin visibility.",
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Action summary"
        },
        "module": {
          "type": "string",
          "enum": ["PO_ENTRY", "IN_TRANSIT", "RTO_TRACKER", "GRN", "DN_TRACKER", "LOGISTICS", "PRINT_TEAM", "POC_DIRECTORY", "ADMIN_IAM"],
          "maxLength": 30,
          "description": "System module where action occurred"
        },
        "referenceNo": {
          "type": "string",
          "maxLength": 100,
          "description": "PO Number, DN Number, or Employee ID affected"
        },
        "details": {
          "type": "string",
          "maxLength": 400,
          "description": "Human-readable audit details"
        },
        "employeeUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID of the acting employee"
        },
        "employeeName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Employee Name displayed to Admin"
        },
        "employeeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50,
          "description": "Employee ID displayed to Admin"
        },
        "employeeRole": {
          "type": "string",
          "enum": ["admin", "backoffice", "warehouse", "logistics", "print"],
          "maxLength": 20,
          "description": "Role of the acting employee"
        },
        "orgScope": {
          "type": "string",
          "enum": ["instamart_ops"],
          "maxLength": 30,
          "description": "Organizational partition scope"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of the activity"
        }
      },
      "required": [
        "action",
        "module",
        "referenceNo",
        "details",
        "employeeUid",
        "employeeName",
        "employeeId",
        "employeeRole",
        "orgScope",
        "createdAt"
      ]
    },
    "PocContact": {
      "title": "PocContact",
      "description": "Instamart Warehouse / Hub POC Team Contact Directory entry with contact number and email ID.",
      "type": "object",
      "properties": {
        "facilityName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Instamart Facility or Warehouse Name"
        },
        "pocName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "POC Person Full Name"
        },
        "designation": {
          "type": "string",
          "maxLength": 100,
          "description": "POC Team Role or Designation"
        },
        "contactNumber": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50,
          "description": "POC Phone / Mobile Contact Number"
        },
        "emailId": {
          "type": "string",
          "maxLength": 120,
          "description": "POC Email ID"
        },
        "cityOrHub": {
          "type": "string",
          "maxLength": 80,
          "description": "City or Region Hub"
        },
        "orgScope": {
          "type": "string",
          "enum": ["instamart_ops"],
          "maxLength": 30,
          "description": "Organizational partition scope"
        },
        "updatedByName": {
          "type": "string",
          "maxLength": 100,
          "description": "Employee who added/updated the POC contact"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp"
        }
      },
      "required": [
        "facilityName",
        "pocName",
        "designation",
        "contactNumber",
        "emailId",
        "cityOrHub",
        "orgScope",
        "updatedByName",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/employees/{userId}": {
      "schema": { "$ref": "#/entities/EmployeeProfile" },
      "description": "Employee directory profiles containing Employee Name, Employee ID, Department Role, and Permissions."
    },
    "/product_catalog/{skuId}": {
      "schema": { "$ref": "#/entities/ProductCatalogItem" },
      "description": "Master Product SKU Catalog for instant Item Name auto-fill."
    },
    "/purchase_orders/{poId}": {
      "schema": { "$ref": "#/entities/PurchaseOrder" },
      "description": "Master collection of Instamart Purchase Orders across PO Entry, Logistics, Print Team, In Transit, and GRN tabs."
    },
    "/dn_records/{dnId}": {
      "schema": { "$ref": "#/entities/DnRecord" },
      "description": "Instamart Discrepancy Note (DN) Tracker records."
    },
    "/poc_contacts/{pocId}": {
      "schema": { "$ref": "#/entities/PocContact" },
      "description": "Instamart POC Team Contact Directory with Phone Numbers and Email IDs."
    },
    "/activity_logs/{logId}": {
      "schema": { "$ref": "#/entities/ActivityLog" },
      "description": "Real-time audit trail for Admin showing which employee (Name & ID) created or updated data."
    }
  }
}
